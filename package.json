{
  "name": "spindle",
  "version": "0.1.0",
  "description": "A deterministic, testable orchestration spine (the spin CLI) for spec-driven development in Claude Code — the CLI never calls a model; slash commands orchestrate Claude around CLI-enforced gates.",
  "type": "module",
  "bin": {
    "spin": "./bin/spin.js"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "plugin"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "guard": "node scripts/guard-no-model-calls.js",
    "guard:authorship": "node scripts/guard-no-fork-tells.js",
    "eval": "node dist/cli/index.js eval --strict",
    "inventory": "node scripts/gen-inventory.js",
    "inventory:check": "node scripts/gen-inventory.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "claude-code",
    "harness",
    "spec-driven-development",
    "data-engineering",
    "agent-orchestration"
  ],
  "license": "MIT",
  "author": "Ivis Ribeiro",
  "repository": "https://github.com/ivisribeiro/spindle"
}
